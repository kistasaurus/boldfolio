{#
/**
 * @file
 * Theme override for a breadcrumb trail.
 *
 * Available variables:
 * - breadcrumb: Breadcrumb trail items.
 */
#}
{% if breadcrumb %}
  <nav role="navigation" aria-labelledby="system-breadcrumb" class="boldfolio-breadcrumbs">
    <h2 id="system-breadcrumb" class="visually-hidden">{{ 'Breadcrumb'|t }}</h2>
    <ol>
    {% for item in breadcrumb %}
        {% set separator = ' /' %}
      <li>
        {% if item.url %}
<a href="{{ item.url }}">{{ item.text }}</a>
<span class="boldfolio-tag-separator">{{ separator }}</span>
        {% else %}
{{ item.text }}<span class="boldfolio-tag-separator">{{ separator }}</span>
        {% endif %}
      </li>
    {% endfor %}
    </ol>
  </nav>
{% endif %}
