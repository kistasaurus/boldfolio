{% if content %}
	<div {{ attributes.addClass('boldfolio-two-column') }}>
		{% if content.sidebar %}
			<div {{ region_attributes.sidebar.addClass('boldfolio-sidebar-region') }}>
				{{ content.sidebar }}
			</div>
		{% endif %}
		{% if content.main %}
			<div {{ region_attributes.main.addClass('boldfolio-main-region') }}>
				{{ content.main }}
			</div>
		{% endif %}
	</div>
{% endif %}
